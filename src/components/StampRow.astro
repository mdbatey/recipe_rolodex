---
import { getCollection } from 'astro:content';
import { tagPath, withBase } from '../lib/paths';
import { recipeTags, tagsByUse } from '../lib/tags';

interface Props {
  /** The tag whose page this is, if any. */
  active?: string;
}

const { active } = Astro.props;
// Every tag in the box (variations' too), not just this page's cards, so you can always jump to another.
const [recipes, variations] = await Promise.all([getCollection('recipes'), getCollection('variations')]);
const tags = tagsByUse(recipes.map((recipe) => ({
  data: { tags: recipeTags(recipe, variations.filter((v) => v.id.startsWith(`${recipe.id}/`))) },
})));
---

{tags.length > 0 && (
  <nav class="stamp-row" aria-label="Stamps">
    <span class="stamp-row__label">Stamps</span>
    <div class="stamps stamp-row__list">
      {tags.map((tag) => tag === active ? (
        // Clicking the current stamp again un-stamps: back to every card
        <a class="stamp" href={withBase('/')} aria-current="page" title="Show all cards">{tag}</a>
      ) : (
        <a class="stamp" href={tagPath(tag)}>{tag}</a>
      ))}
    </div>
  </nav>
)}

<style>
  .stamp-row { display: flex; align-items: center; gap: var(--space-3); }
  .stamp-row__label {
    flex-shrink: 0;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    color: var(--color-pencil);
  }
  .stamp-row__list { row-gap: var(--space-3); }
  /* Stamps keep their look but get a 44px-tall tap area */
  .stamp { position: relative; }
  .stamp::after { content: ''; position: absolute; inset: -11px -4px; }
  .stamp:hover { background: var(--color-card); }
  .stamp[aria-current='page'] { background: var(--color-accent); color: var(--color-on-accent); }

  /* One scrollable row of stamps on phones, like the tabs */
  @media (max-width: 600px) {
    .stamp-row__list { flex-wrap: nowrap; overflow-x: auto; padding: 6px 2px; }
    .stamp { flex-shrink: 0; }
  }
</style>
