---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import RecipePage from '../../../components/RecipePage.astro';
import { splitVariationId } from '../../../lib/versions';

export const getStaticPaths = (async () => {
  const [recipes, variations] = await Promise.all([getCollection('recipes'), getCollection('variations')]);
  return variations.map((active) => {
    const { recipe: slug, version } = splitVariationId(active.id);
    const recipe = recipes.find((r) => r.id === slug);
    if (!recipe) throw new Error(`Variation ${active.id} has no recipe: add src/content/recipes/${slug}/index.md`);
    const siblings = variations.filter((v) => splitVariationId(v.id).recipe === slug);
    return { params: { slug, version }, props: { recipe, variations: siblings, active } };
  });
}) satisfies GetStaticPaths;

const { recipe, variations, active } = Astro.props;
---

<RecipePage recipe={recipe} variations={variations} active={active} />
