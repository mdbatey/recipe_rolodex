---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecipeBox from '../../components/RecipeBox.astro';
import { allTags, tagLabel } from '../../lib/tags';

export const getStaticPaths = (async () => {
  const recipes = await getCollection('recipes');
  return allTags(recipes).map((tag) => ({
    params: { tag },
    props: { tag, recipes: recipes.filter((recipe) => recipe.data.tags.includes(tag)) },
  }));
}) satisfies GetStaticPaths;

const { tag, recipes } = Astro.props;
---

<Base title={`${tagLabel(tag)} · Recipe Rolodex`} description={`Recipes stamped ${tag} in the Recipe Rolodex.`}>
  <RecipeBox recipes={recipes} tag={tag} />
</Base>
