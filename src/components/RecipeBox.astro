---
import type { CollectionEntry } from 'astro:content';
import RecipeCard from './RecipeCard.astro';
import CategoryTabs from './CategoryTabs.astro';
import StampRow from './StampRow.astro';
import { withBase } from '../lib/paths';
import { categoryLabel, type CategoryId } from '../lib/categories';

interface Props {
  /** The recipes to show as cards. */
  recipes: CollectionEntry<'recipes'>[];
  /** The category tab this page is: "all" on the home page. */
  category?: CategoryId | 'all';
  /** The tag this page lists, on a tag page (no tab is current there). */
  tag?: string;
}

const { recipes, category, tag } = Astro.props;
const sorted = [...recipes].sort((a, b) => a.data.title.localeCompare(b.data.title));
const cards = `${sorted.length} ${sorted.length === 1 ? 'card' : 'cards'}`;
const footnote = tag
  ? `${cards} stamped ${tag}`
  : category && category !== 'all'
    ? `${cards} behind ${categoryLabel(category)}`
    : `${cards} in the box`;
---

<header class="masthead">
  <div>
    <h1 class="site-title">Recipe Rolodex</h1>
    <p class="tagline">a box of cards worth keeping</p>
  </div>
  <a class="btn" href={withBase('/add/')}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
    Add a recipe
  </a>
</header>

<!-- Hidden until the Pagefind index loads, so a page without it (dev server, no JS) shows no dead field. -->
<div class="search" data-search data-pagefind={withBase('/pagefind/pagefind.js')} data-base={withBase('/')} hidden>
  <label class="label" for="search">Search the box</label>
  <div class="search__box">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
    <input id="search" type="search" placeholder="beans, chili, Mor Mor…" autocomplete="off" />
  </div>
</div>

<CategoryTabs active={category} />
<StampRow active={tag} />

{sorted.length > 0 ? (
  <div class="card-grid">
    {sorted.map((recipe, i) => <RecipeCard recipe={recipe} index={i} />)}
  </div>
) : (
  <p class="empty">No cards behind this divider yet.</p>
)}

<footer class="footnote" data-footnote={footnote} aria-live="polite">{footnote}</footer>

<script>
  import { matchingCards } from '../lib/search';

  type PagefindResult = { data: () => Promise<{ url: string }> };
  type Pagefind = {
    options: (options: { baseUrl: string }) => Promise<void>;
    debouncedSearch: (query: string) => Promise<{ results: PagefindResult[] } | null>;
  };

  const root = document.querySelector<HTMLElement>('[data-search]');
  const input = root?.querySelector<HTMLInputElement>('input');
  const footnote = document.querySelector<HTMLElement>('[data-footnote]');
  const cards = [...document.querySelectorAll<HTMLAnchorElement>('.card-grid a')];

  function show(visible: Set<string> | null, query: string) {
    for (const card of cards) card.hidden = visible !== null && !visible.has(card.getAttribute('href')!);
    if (!footnote) return;
    if (visible === null) {
      footnote.textContent = footnote.dataset.footnote!;
    } else if (visible.size === 0) {
      footnote.textContent = `No cards match "${query}"`;
    } else {
      footnote.textContent = `${visible.size} of ${cards.length} ${cards.length === 1 ? 'card matches' : 'cards match'} "${query}"`;
    }
  }

  async function start() {
    if (!root || !input) return;
    let pagefind: Pagefind;
    try {
      pagefind = await import(/* @vite-ignore */ root.dataset.pagefind!);
      await pagefind.options({ baseUrl: root.dataset.base! });
    } catch {
      return; // no index (the dev server, before `pagefind` runs): leave search hidden
    }
    root.hidden = false;

    input.addEventListener('input', async () => {
      const query = input.value.trim();
      if (query === '') return show(null, query);
      const search = await pagefind.debouncedSearch(query);
      if (search === null || input.value.trim() !== query) return; // superseded by later typing
      const urls = await Promise.all(search.results.map(async (result) => (await result.data()).url));
      show(matchingCards(cards.map((card) => card.getAttribute('href')!), urls), query);
    });
  }

  start();
</script>

<style>
  .masthead { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-5); }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-button);
    box-shadow: var(--shadow-button);
    font-family: var(--font-display);
    font-size: 1.125rem;
    letter-spacing: 1px;
    text-decoration: none;
  }
  .btn:hover { background: var(--color-accent-hover); color: var(--color-on-accent); }
  .site-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-3xl);
    letter-spacing: 1px;
  }
  .tagline { margin: var(--space-1) 0 0; font-family: var(--font-hand); font-size: 1.625rem; color: var(--color-pencil); }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 36px 28px;
    padding-top: var(--space-3);
  }
  .search { display: flex; flex-direction: column; gap: var(--space-2); }
  .search[hidden] { display: none; }
  .label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .search__box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    padding: 0 var(--space-4);
    background: var(--color-card);
    border: var(--border-ink);
    border-radius: var(--radius-button);
    box-shadow: var(--shadow-hard);
    color: var(--color-ink-soft);
  }
  .search__box:focus-within { outline: 3px solid var(--color-pen); outline-offset: 2px; }
  .search__box input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 1.125rem;
    color: var(--color-ink);
    outline: none;
  }
  .search__box input::placeholder { color: var(--color-ink-faint); }
  .empty {
    margin: 0;
    padding: var(--space-7) var(--space-5);
    text-align: center;
    font-family: var(--font-hand);
    font-size: 1.75rem;
    color: var(--color-pencil);
    border: 2px dashed var(--color-wood);
    border-radius: var(--radius-card);
  }
  .footnote { text-align: center; font-family: var(--font-hand); font-size: 1.375rem; color: var(--color-pencil); }

  @media (max-width: 600px) {
    .site-title { font-size: 2.5rem; }
  }
</style>
