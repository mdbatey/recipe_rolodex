---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecipeBox from '../../components/RecipeBox.astro';
import { CATEGORIES } from '../../lib/categories';

// Every category gets a page, even with no recipes yet: the dividers are always in the box.
export const getStaticPaths = (async () => {
  const recipes = await getCollection('recipes');
  return CATEGORIES.map((category) => ({
    params: { category: category.id },
    props: { category, recipes: recipes.filter((recipe) => recipe.data.category === category.id) },
  }));
}) satisfies GetStaticPaths;

const { category, recipes } = Astro.props;
---

<Base title={`${category.label} · Recipe Rolodex`} description={`${category.label} recipes in the Recipe Rolodex.`}>
  <RecipeBox recipes={recipes} category={category.id} />
</Base>
