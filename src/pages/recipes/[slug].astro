---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/paths';

export const getStaticPaths = (async () => {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}) satisfies GetStaticPaths;

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { title, cover, coverAlt, tags, servings, prepTime, cookTime, source, dateAdded } = recipe.data;
const { Content } = await render(recipe);

const stats = [
  { label: 'Serves', value: servings?.toString() },
  { label: 'Prep', value: prepTime },
  { label: 'Cook', value: cookTime },
].filter((stat): stat is { label: string; value: string } => Boolean(stat.value));

const sourceIsLink = source ? /^https?:\/\//.test(source) : false;
const added = dateAdded.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base title={`${title} · Recipe Rolodex`}>
  <nav class="topbar">
    <a class="back-link" href={withBase('/')}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
      Back to the box
    </a>
    <span class="topbar__brand">Recipe Rolodex</span>
  </nav>

  <div class="recipe-layout">
    <div class="recipe-aside">
      <figure class="snapshot">
        <span class="tape tape--left" aria-hidden="true"></span>
        <span class="tape tape--right" aria-hidden="true"></span>
        <Picture
          class="snapshot__img"
          src={cover}
          alt={coverAlt ?? ''}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[480, 800, 1200]}
          sizes="(max-width: 1000px) 90vw, 420px"
          loading="eager"
        />
      </figure>

      {stats.length > 0 && (
        <dl class="stats" style={`--stat-count: ${stats.length}`}>
          {stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      )}

      {(tags.length > 0 || source) && (
        <div class="stamps">
          {tags.map((tag) => <span class="stamp stamp--lg">{tag}</span>)}
          {source && (
            <span class="source">
              from {sourceIsLink ? <a href={source} rel="noopener">{new URL(source).hostname}</a> : source}
            </span>
          )}
        </div>
      )}
    </div>

    <article class="index-card">
      <header class="index-card__head">
        <h1 class="index-card__title">{title}</h1>
        <span class="index-card__date">added {added}</span>
      </header>
      <div class="index-card__body ruled">
        <Content />
      </div>
    </article>
  </div>
</Base>

<style>
  .topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .topbar__brand { font-family: var(--font-display); font-size: 1.375rem; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-min);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    letter-spacing: 1px;
    text-decoration: none;
  }

  .recipe-layout { display: flex; flex-wrap: wrap; gap: var(--space-7); align-items: flex-start; }
  .recipe-aside { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }

  .snapshot {
    position: relative;
    margin: 0;
    padding: 14px 14px 22px;
    background: var(--color-photo-mat);
    box-shadow: var(--shadow-photo);
    transform: rotate(-1.5deg);
  }
  .snapshot .tape { top: -14px; width: 110px; height: 30px; }
  .snapshot .tape--left { left: 24px; transform: rotate(-8deg); }
  .snapshot .tape--right { right: 24px; transform: rotate(7deg); }
  .snapshot :global(.snapshot__img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }

  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(var(--stat-count), minmax(0, 1fr));
    background: var(--color-card);
    border: var(--border-ink);
    box-shadow: var(--shadow-hard);
  }
  .stats > div { padding: 14px 16px; }
  .stats > div + div { border-left: var(--border-dashed); }
  .stats dt { font-family: var(--font-display); font-size: var(--text-xs); letter-spacing: 2px; text-transform: uppercase; color: var(--color-ink-soft); }
  .stats dd { margin: var(--space-1) 0 0; font-size: 1.375rem; font-weight: 700; }

  .stamp--lg { font-size: 0.8125rem; line-height: 26px; padding: 0 8px; }
  .source { font-family: var(--font-hand); font-size: 1.375rem; color: var(--color-ink-soft); padding-left: var(--space-2); }

  .index-card {
    flex: 999 1 560px;
    min-width: 0;
    background: var(--color-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card-lifted);
  }
  .index-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-7) 10px;
    border-bottom: 2px solid var(--color-rule-red);
  }
  .index-card__title {
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--color-pen);
  }
  .index-card__date { font-family: var(--font-display); font-size: 0.8125rem; letter-spacing: 1px; color: var(--color-ink-soft); }
  .index-card__body { --rule: var(--rule-step-page); padding: var(--space-2) var(--space-7) var(--space-7); }

  /* Recipe Markdown: "## Ingredients" and "## Steps" by convention (ADR 0001). */
  .index-card__body :global(h2) {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
    line-height: calc(var(--rule) * 2);
    color: var(--color-accent);
  }
  .index-card__body :global(p) { margin: 0 0 var(--rule); }
  .index-card__body :global(ul) { list-style: none; margin: 0; padding: 0; }
  .index-card__body :global(ul > li) { position: relative; padding-left: 30px; }
  .index-card__body :global(ul > li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc((var(--rule) - 16px) / 2);
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--color-ink-soft);
    border-radius: 2px;
  }
  .index-card__body :global(ol) { list-style: none; margin: 0; padding: 0; counter-reset: step; }
  .index-card__body :global(ol > li) { display: flex; gap: 14px; counter-increment: step; }
  .index-card__body :global(ol > li)::before {
    content: counter(step) '.';
    flex-shrink: 0;
    width: 28px;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .index-card__head, .index-card__body { padding-left: var(--space-5); padding-right: var(--space-5); }
    .index-card__title { font-size: 2.75rem; }
  }

  @media print {
    .topbar, .snapshot .tape, .stamps { display: none; }
    .index-card, .snapshot { box-shadow: none; transform: none; }
  }
</style>
