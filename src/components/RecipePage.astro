---
import { render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { categoryPath, recipePath, tagPath, withBase } from '../lib/paths';
import { categoryLabel } from '../lib/categories';
import { editUrl } from '../lib/github';
import { sourceLabel } from '../lib/source';
import { versionTags } from '../lib/tags';
import { originalLabel, splitVariationId } from '../lib/versions';
import NutritionLabel from './NutritionLabel.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props {
  recipe: CollectionEntry<'recipes'>;
  /** This recipe's variations, in tab order. */
  variations: CollectionEntry<'variations'>[];
  /** The variation this page shows; absent, the original. */
  active?: CollectionEntry<'variations'>;
}

const { recipe, variations, active } = Astro.props;
const { title, category, source } = recipe.data;
const tags = versionTags(recipe, active);
// A variation's own servings, times, date and notes win; it shows the original's photo unless it has its own.
const own = active?.data;
const cover = own?.cover ?? recipe.data.cover;
const coverAlt = own?.cover ? own.coverAlt : recipe.data.coverAlt;
const servings = own?.servings ?? recipe.data.servings;
const prepTime = own?.prepTime ?? recipe.data.prepTime;
const cookTime = own?.cookTime ?? recipe.data.cookTime;
const dateAdded = own?.dateAdded ?? recipe.data.dateAdded;
const notes = own ? own.notes : recipe.data.notes;
// Never the original's nutrition on a variation: its ingredients differ.
const nutrition = own ? own.nutrition : recipe.data.nutrition;
const { Content } = await render(active ?? recipe);
const activeVersion = active ? splitVariationId(active.id).version : undefined;

const tabs = variations.length === 0 ? [] : [
  { label: originalLabel(recipe.data), href: recipePath(recipe.id), current: !active },
  ...variations.map((variation) => {
    const { version } = splitVariationId(variation.id);
    return { label: variation.data.label, href: recipePath(recipe.id, version), current: variation.id === active?.id };
  }),
];

const stats = [
  { label: 'Serves', value: servings?.toString() },
  { label: 'Prep', value: prepTime },
  { label: 'Cook', value: cookTime },
].filter((stat): stat is { label: string; value: string } => Boolean(stat.value));

const sourceLink = source ? sourceLabel(source) : undefined;
const monthYear = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const added = monthYear(dateAdded);
---

<Base title={active ? `${title} (${active.data.label}) · Recipe Rolodex` : `${title} · Recipe Rolodex`}>
  <nav class="topbar">
    <a class="back-link" href={withBase('/')}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
      Back to the box
    </a>
    <span class="topbar__brand">Recipe Rolodex</span>
  </nav>

  <div class="recipe-layout" data-pagefind-body>
    <div class="recipe-aside">
      <figure class="snapshot">
        <span class="tape tape--left" aria-hidden="true"></span>
        <span class="tape tape--right" aria-hidden="true"></span>
        {cover ? (
          <Picture
            class="snapshot__img"
            src={cover}
            alt={coverAlt ?? ''}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[480, 800, 1200]}
            sizes="(max-width: 1000px) 90vw, 420px"
            loading="eager"
          />
        ) : (
          <PhotoPlaceholder class="snapshot__img" title={title} />
        )}
      </figure>

      {stats.length > 0 && (
        <dl class="stats" style={`--stat-count: ${stats.length}`}>
          {stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <p class="filed">filed under <a href={categoryPath(category)}>{categoryLabel(category)}</a></p>

      {(tags.length > 0 || source) && (
        <div class="stamps">
          {tags.map((tag) => <a class="stamp stamp--lg" href={tagPath(tag)}>{tag}</a>)}
          {source && (
            <span class="source">
              from {sourceLink?.href ? <a href={sourceLink.href} rel="noopener">{sourceLink.text}</a> : sourceLink?.text}
            </span>
          )}
        </div>
      )}

      <a class="edit-link" href={editUrl(recipe.id, activeVersion)} target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
        Edit this card on GitHub
      </a>

      {nutrition && <NutritionLabel nutrition={nutrition} />}
    </div>

    <article class="index-card">
      {tabs.length > 0 && (
        <nav class="versions" aria-label="Versions" data-pagefind-ignore>
          {tabs.map((tab) => (
            <a class="version" href={tab.href} aria-current={tab.current ? 'page' : undefined}>{tab.label}</a>
          ))}
        </nav>
      )}
      <header class="index-card__head">
        <h1 class="index-card__title">{title}</h1>
        <span class="index-card__date" data-pagefind-ignore>added {added}</span>
      </header>
      <div class="index-card__body ruled">
        <Content />
        {notes.length > 0 && (
          <section class="notes" aria-label="Notes">
            {notes.map((note) => (
              <p class="note">
                <time datetime={note.date.toISOString().slice(0, 10)}>{monthYear(note.date)}:</time> {note.text}
              </p>
            ))}
          </section>
        )}
      </div>
    </article>
  </div>
</Base>

<style>
  .topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .topbar__brand { font-family: var(--font-display); font-size: 1.375rem; }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-min);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    letter-spacing: 1px;
    text-decoration: none;
  }

  .recipe-layout { display: flex; flex-wrap: wrap; gap: var(--space-7); align-items: flex-start; }
  .recipe-aside { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }

  .snapshot {
    position: relative;
    margin: 0;
    padding: 14px 14px 22px;
    background: var(--color-photo-mat);
    box-shadow: var(--shadow-photo);
    transform: rotate(-1.5deg);
  }
  .snapshot .tape { top: -14px; width: 110px; height: 30px; }
  .snapshot .tape--left { left: 24px; transform: rotate(-8deg); }
  .snapshot .tape--right { right: 24px; transform: rotate(7deg); }
  .snapshot :global(.snapshot__img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }

  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(var(--stat-count), minmax(0, 1fr));
    background: var(--color-card);
    border: var(--border-ink);
    box-shadow: var(--shadow-hard);
  }
  .stats > div { padding: 14px 16px; }
  .stats > div + div { border-left: var(--border-dashed); }
  .stats dt { font-family: var(--font-display); font-size: var(--text-xs); letter-spacing: 2px; text-transform: uppercase; color: var(--color-ink-soft); }
  .stats dd { margin: var(--space-1) 0 0; font-size: 1.375rem; font-weight: 700; }

  .stamp--lg { font-size: 0.8125rem; line-height: 26px; padding: 0 8px; }
  /* Tag links keep the stamp's look but get a 44px-tall tap area */
  a.stamp--lg { position: relative; }
  a.stamp--lg::after { content: ''; position: absolute; inset: -9px -4px; }
  .edit-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch-min);
    font-size: 0.875rem;
    color: var(--color-ink-soft);
  }
  .edit-link:hover { color: var(--color-accent); }
  .notes { margin-top: var(--rule); }
  /* Beats the recipe body's paragraph spacing, so each note sits on the next rule */
  .index-card__body .note {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    color: var(--color-pen);
  }
  .note time { font-weight: 700; }
  .filed { margin: 0; font-family: var(--font-hand); font-size: 1.5rem; color: var(--color-pencil); }
  .source { font-family: var(--font-hand); font-size: 1.375rem; color: var(--color-ink-soft); padding-left: var(--space-2); }

  /* Version tabs: small dividers standing on the card's top edge */
  .versions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0 var(--space-7);
    margin-top: -38px;
    margin-bottom: 0;
  }
  .version {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 16px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    letter-spacing: 1px;
    color: var(--color-ink-soft);
    text-decoration: none;
    background: var(--tab-1);
    border: 2px solid var(--color-wood);
    border-bottom: 0;
    border-radius: var(--radius-tab);
  }
  .version:nth-child(2) { background: var(--tab-3); }
  .version:nth-child(3) { background: var(--tab-4); }
  .version:hover { color: var(--color-ink); filter: brightness(1.04); }
  .version[aria-current='page'] {
    background: var(--color-card);
    color: var(--color-ink);
    min-height: 44px;
    border-color: transparent;
    position: relative;
    top: 0;
  }
  /* Room above the card for its tabs, without pushing the photo down */
  .index-card:has(.versions) { margin-top: 44px; }

  .index-card {
    flex: 999 1 560px;
    min-width: 0;
    background: var(--color-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card-lifted);
  }
  .index-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-7) 10px;
    border-bottom: 2px solid var(--color-rule-red);
  }
  .index-card__title {
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--color-pen);
  }
  .index-card__date { font-family: var(--font-display); font-size: 0.8125rem; letter-spacing: 1px; color: var(--color-ink-soft); }
  .index-card__body { --rule: var(--rule-step-page); padding: var(--space-2) var(--space-7) var(--space-7); }

  /* Recipe Markdown: "## Ingredients" and "## Steps" by convention (ADR 0001). */
  .index-card__body :global(h2) {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-heading);
    text-transform: uppercase;
    line-height: calc(var(--rule) * 2);
    color: var(--color-accent);
  }
  /* Ingredient groups ("### Salmon", "### Salsa"): a handwritten label on its own rule */
  .index-card__body :global(h3) {
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: var(--rule);
    color: var(--color-pen);
  }
  .index-card__body :global(h3:not(:first-of-type)) { margin-top: var(--rule); }
  .index-card__body :global(p) { margin: 0 0 var(--rule); }
  .index-card__body :global(ul) { list-style: none; margin: 0; padding: 0; }
  .index-card__body :global(ul > li) { position: relative; padding-left: 30px; }
  .index-card__body :global(ul > li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc((var(--rule) - 16px) / 2);
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--color-ink-soft);
    border-radius: 2px;
  }
  .index-card__body :global(ol) { list-style: none; margin: 0; padding: 0; counter-reset: step; }
  .index-card__body :global(ol > li) { display: flex; gap: 14px; counter-increment: step; }
  .index-card__body :global(ol > li)::before {
    content: counter(step) '.';
    flex-shrink: 0;
    width: 28px;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.75rem;
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .index-card__head, .index-card__body, .versions { padding-left: var(--space-5); padding-right: var(--space-5); }
    .index-card__title { font-size: 2.75rem; }
  }

  @media print {
    .topbar, .snapshot .tape, .stamps, .edit-link, .version:not([aria-current]) { display: none; }
    .index-card, .snapshot { box-shadow: none; transform: none; }
  }
</style>
