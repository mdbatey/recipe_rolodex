---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { recipePath } from '../lib/paths';
import { sourceLabel } from '../lib/source';
import { recipeTags, versionForTag, versionTags } from '../lib/tags';
import { splitVariationId } from '../lib/versions';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

interface Props {
  recipe: CollectionEntry<'recipes'>;
  /** Position in the grid; picks one of the six design tilts so neighbours differ. */
  index?: number;
  /** On a tag page: the card opens, labels and stamps the version that has this tag. */
  forTag?: string;
}

const { recipe, index = 0, forTag } = Astro.props;
const tilt = `var(--tilt-${(index % 6) + 1})`;
const { title, cover, coverAlt, servings, prepTime, cookTime, source } = recipe.data;
const variations = await getCollection('variations', (v) => v.id.startsWith(`${recipe.id}/`));
const matched = forTag ? versionForTag(forTag, recipe, variations) : undefined;
const href = recipePath(recipe.id, matched && splitVariationId(matched.id).version);
// In the box, every version's stamps; on a tag page, just the matching version's.
const tags = forTag ? versionTags(recipe, matched) : recipeTags(recipe, variations);
const versionNote = matched ? matched.data.label : variations.length > 0 ? `${variations.length + 1} versions` : null;
const times = [prepTime, cookTime].filter(Boolean).join(' + ');
const meta = [servings ? `Serves ${servings}` : null, times || null].filter(Boolean).join(' · ');
---

<!-- data-recipe: the recipe's own page, which search matches against even when href opens a variation -->
<a class="recipe-card" href={href} data-recipe={recipePath(recipe.id)} style={`--card-tilt: ${tilt}`}>
  <span class="tape" aria-hidden="true"></span>
  {cover
    ? <Image class="recipe-card__photo" src={cover} alt={coverAlt ?? ''} widths={[320, 640]} sizes="(max-width: 600px) 90vw, 280px" />
    : <PhotoPlaceholder class="recipe-card__photo" title={title} />}
  <div class="recipe-card__head">
    <h2 class="recipe-card__title">{title}</h2>
  </div>
  <div class="recipe-card__body ruled">
    {meta && <span>{meta}</span>}
    {source && <span class="muted">from {sourceLabel(source).text}</span>}
    {versionNote && <span class="versions">{versionNote}</span>}
    {tags.length > 0 && (
      <div class="stamps">
        {tags.map((tag) => <span class="stamp">{tag}</span>)}
      </div>
    )}
  </div>
</a>

<style>
  .recipe-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-card);
    color: var(--color-ink);
    text-decoration: none;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transform: var(--card-tilt, none);
    transition: var(--transition);
  }
  .recipe-card[hidden] { display: none; }
  .recipe-card:hover {
    color: var(--color-ink);
    box-shadow: var(--shadow-card-lifted);
    transform: translateY(-3px);
  }
  .recipe-card .tape { top: -12px; left: 50%; margin-left: -46px; transform: rotate(-3deg); }
  /* :global so it also sizes the PhotoPlaceholder component */
  .recipe-card :global(.recipe-card__photo) {
    display: block;
    width: calc(100% - 28px);
    height: 168px;
    margin: 14px 14px 0;
    object-fit: cover;
    border: 6px solid var(--color-photo-mat);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
  }
  .recipe-card__head { padding: 14px 18px 4px; border-bottom: 2px solid var(--color-rule-red); }
  .recipe-card__title {
    margin: 0;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: 1.1;
    color: var(--color-pen);
  }
  .recipe-card__body {
    --rule: var(--rule-step-card);
    display: flex;
    flex-direction: column;
    min-height: calc(var(--rule-step-card) * 3);
    padding: 6px 18px 18px;
    font-size: 0.9375rem;
    overflow-wrap: anywhere; /* a long word never runs off the card */
  }
  .recipe-card__body .stamps { padding-top: var(--space-2); }
  .muted { color: var(--color-ink-soft); }
  .versions { font-family: var(--font-hand); font-size: 1.25rem; color: var(--color-pen); }
</style>
